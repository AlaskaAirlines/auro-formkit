{
  "name": "@aurodesignsystem/react-framework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:app": "vite",
    "dev:app:open": "npm run dev:app -- --open",
    "build:app": "tsc -b && vite build",
    "preview": "vite preview",
    "clean:cache": "rm -rf node_modules/.vite",
    "pretest:framework": "npm run clean:cache && npx playwright install chromium",
    "test:framework": "playwright test",
    "pretest:framework:report": "npm run clean:cache && npx playwright install chromium",
    "test:framework:report": "playwright test --config=playwright.report.config.ts"
  },
  "dependencies": {
    "@aurodesignsystem/auro-formkit": "file:../../",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "monocart-reporter": "^2.14.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}
